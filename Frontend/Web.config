<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="TenderManagement"
         connectionString="Data Source=YOUR_SQL_SERVER;Initial Catalog=TenderManagementDB;Integrated Security=True;Encrypt=True;TrustServerCertificate=False;Application Name=DepartmentModule"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="SessionUserIdKey" value="UserId" />
    <add key="SessionRoleKey" value="RoleName" />
    <add key="SessionDepartmentIdKey" value="DepartmentId" />
    <add key="DepartmentPanelLoginUrl" value="~/Pages/Login.aspx" />
    <add key="UploadRoot" value="~/Uploads" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="51200" requestValidationMode="4.5" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/Pages/Error.aspx" />
    <httpCookies httpOnlyCookies="true" requireSSL="true" sameSite="Lax" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="Predictable" />
    <sessionState cookieless="UseCookies" regenerateExpiredSessionId="true" />
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="Pages/Home.aspx" />
      </files>
    </defaultDocument>
    <urlMappings enabled="true">
      <add url="~/login" mappedUrl="~/Pages/Login.aspx" />
      <add url="~/register" mappedUrl="~/Pages/Register.aspx" />
      <add url="~/dashboard" mappedUrl="~/Pages/Default.aspx" />
      <add url="~/tenders" mappedUrl="~/Pages/Tenders.aspx" />
      <add url="~/approvals" mappedUrl="~/Pages/Approvals.aspx" />
      <add url="~/admin" mappedUrl="~/Pages/Admin.aspx" />
      <add url="~/admin/users" mappedUrl="~/Pages/AdminUsers.aspx" />
      <add url="~/admin/departments" mappedUrl="~/Pages/AdminDepartments.aspx" />
      <add url="~/admin/announcements" mappedUrl="~/Pages/AdminAnnouncements.aspx" />
      <add url="~/tenders/new" mappedUrl="~/Pages/TenderForm.aspx" />
    </urlMappings>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
