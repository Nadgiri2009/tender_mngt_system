@baseUrl = http://localhost:5050/api
@mobile = replace-with-an-active-account-mobile
@otp = replace-with-the-six-digit-code-from-the-development-api-console

### Request a one-time sign-in code
POST {{baseUrl}}/auth/request-otp
Content-Type: application/json

{
  "mobile": "{{mobile}}"
}

### Verify the code and sign in
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "mobile": "{{mobile}}",
  "otp": "{{otp}}"
}
