@baseUrl = http://localhost:5050/api
@mobile = 9876543210
@otp = replace-with-the-six-digit-developmentOtp-from-the-request-response

### Request a one-time sign-in code
POST {{baseUrl}}/auth/request-otp
Content-Type: application/json

{
  "mobile": "{{mobile}}"
}

### Verify the code and sign in
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "mobile": "{{mobile}}",
  "otp": "{{otp}}"
}
